{
  "uid": "titanedge-logs",
  "title": "TitanEdge / Logs",
  "tags": [
    "titanedge",
    "logs"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "query": "titanedge",
        "current": {
          "text": "titanedge",
          "value": "titanedge"
        },
        "options": []
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "TitanEdge",
      "type": "dashboards",
      "tags": [
        "titanedge"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Log lines / s by level",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (level) (rate({namespace=~\"$namespace\"} | json | __error__=\"\" [1m]))",
          "legendFormat": "{{level}}"
        }
      ],
      "id": 1
    },
    {
      "type": "logs",
      "title": "Errors & warnings",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=~\"$namespace\"} | json | level=~\"ERROR|WARN\" |~ \"$search\"",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "logs",
      "title": "All logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 14
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=~\"$namespace\"} |~ \"$search\"",
          "refId": "A"
        }
      ],
      "id": 3
    }
  ]
}
