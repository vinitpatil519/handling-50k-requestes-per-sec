          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(titan_worker_events_total{namespace=~\"$namespace\",result=\"ok\"}[1m]))",
          "legendFormat": "consumed",
          "refId": "B"
