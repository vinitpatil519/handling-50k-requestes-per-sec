name               = "titanedge"
environment        = "dev"
region             = "us-east-1"
kubernetes_version = "1.35"

# Lock the API endpoint down to your IP / VPN.
api_allowed_cidrs = ["203.0.113.10/32"]

admin_principal_arns = [
  # "arn:aws:iam::123456789012:role/platform-admins",
]

managed_datastores = true
single_nat_gateway = true
app_max_nodes      = 30
loadgen_max_nodes  = 20
